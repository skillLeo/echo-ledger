{
    "pack": "assist",
    "version": "1.0.1",
    "contract": "1.9.0-b",
    "updated_at": "2026-11-16",
    "note": "Live Assist prompt pack (v1.9 L1.5): the system rules and one template per meeting type. A template's {{name}} placeholders are the context blocks in cache order: what never changes first, the question last. Read through App\\Services\\Assist\\PromptPack; no provider is called here.",
    "system": "system.md",
    "placeholders": [
        "system_rules",
        "brief",
        "documents",
        "project_memory",
        "facts_ledger",
        "running_summary",
        "transcript_blocks",
        "last_turns",
        "hint_level",
        "language_help",
        "question"
    ],
    "hint_levels": ["keywords", "outline", "full"],
    "language_help": ["off", "urdu", "roman_urdu", "arabic"],
    "language_line_prefixes": {"urdu": "Urdu:", "roman_urdu": "Roman Urdu:", "arabic": "Arabic:"},
    "skip": "SKIP",
    "consent_line": "Just so you know: I record this call and use an AI assistant that takes notes and suggests points to me. Is that okay with you?",
    "templates": {
        "interview": {
            "file": "interview.md",
            "default_hint_level": "outline",
            "reminder": "Check whether this interview allows AI help.",
            "reminder_kind": "interview"
        },
        "boss": {
            "file": "boss.md",
            "default_hint_level": "full",
            "reminder_kind": "consent"
        },
        "existing_client": {
            "file": "existing_client.md",
            "default_hint_level": "full",
            "reminder_kind": "consent"
        },
        "new_client": {
            "file": "new_client.md",
            "default_hint_level": "full",
            "reminder_kind": "consent"
        },
        "general": {
            "file": "general.md",
            "default_hint_level": "full",
            "reminder_kind": "consent"
        }
    }
}
