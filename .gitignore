# OS / editor noise (each app also has its own .gitignore)
.DS_Store
Thumbs.db
desktop.ini
/.idea/
*.swp

# Local secrets and signing material must never be committed
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
!**/fixtures/**/*.pem
local.properties

# Environment files at any depth (templates stay tracked)
.env
.env.*
!.env.example

# Design review screenshots (local only)
/design-review/
