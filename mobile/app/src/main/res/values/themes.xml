<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light window colours: the same tokens as ui/Tokens.kt (LightColors). -->
    <color name="el_background">#FFF9F9FB</color>
    <color name="el_brand">#FF3E63DD</color>

    <style name="Theme.EchoLedger" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/el_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/el_brand</item>
    </style>

    <style name="Theme.EchoLedger.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
