<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon (or Samsung Routines, a back tap): Record now (since v1.6: a call going on is recorded on
     both sides, else a voice note) and Live Translate on and off (plan B2). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="record_now"
        android:shortcutShortLabel="@string/shortcut_record_now">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.echoledger.mobile.tile.TileTrampolineActivity"
            android:targetPackage="com.echoledger.mobile">
            <extra android:name="from" android:value="App shortcut" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="game_translate"
        android:shortcutShortLabel="@string/tile_game_translate">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.echoledger.mobile.translate.TranslateToggleActivity"
            android:targetPackage="com.echoledger.mobile">
            <extra android:name="mode" android:value="game" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="watch_translate"
        android:shortcutShortLabel="@string/tile_watch_translate">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.echoledger.mobile.translate.TranslateToggleActivity"
            android:targetPackage="com.echoledger.mobile">
            <extra android:name="mode" android:value="watch" />
        </intent>
    </shortcut>
</shortcuts>
