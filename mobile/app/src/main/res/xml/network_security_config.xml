<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Server certificate pinning is enforced in code (OkHttp CertificatePinner with the
     pin set received at pairing), so pins can rotate without an app update. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
