<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12 and later): the 4 x 2 widget with sample content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_preview_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_label"
                android:textColor="@color/widget_preview_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_status"
            android:textColor="@color/widget_preview_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_preview_title"
            android:textColor="@color/widget_preview_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_line"
            android:textColor="@color/widget_preview_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_preview_button"
        android:contentDescription="@string/shortcut_record_now"
        android:padding="14dp"
        android:src="@drawable/ic_stat_rec" />
</LinearLayout>
