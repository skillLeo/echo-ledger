<?xml version="1.0" encoding="utf-8"?>
<!-- The website build (since v1.5, mobile/DISTRIBUTION.md): it updates itself from the server's downloads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hands a downloaded update (checked against the server's SHA-256) to Android's installer, which asks first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        The Phone app's own call recordings (since v1.8, 0.3): since Android 11 the media store names the app that made a
        file, and Android says whether that app came with the phone, only for apps EchoLedger may see. Without these, a
        Galaxy's in-call app reads as unknown and every call would wait for the person. Also the Phone app's call settings.
    -->
    <queries>
        <package android:name="com.samsung.android.dialer" />
        <package android:name="com.samsung.android.incallui" />
        <package android:name="com.android.incallui" />
        <package android:name="com.android.soundrecorder" />
        <package android:name="com.oplus.dialer" />
        <package android:name="com.oplus.incallui" />
        <package android:name="com.coloros.soundrecorder" />
        <package android:name="com.oneplus.dialer" />
        <package android:name="com.oneplus.incallui" />
        <package android:name="com.vivo.incallui" />
        <package android:name="com.android.bbksoundrecorder" />
        <package android:name="com.huawei.soundrecorder" />
        <package android:name="com.hihonor.soundrecorder" />
        <package android:name="com.google.android.dialer" />
        <intent>
            <action android:name="android.telecom.action.SHOW_CALL_SETTINGS" />
        </intent>
    </queries>

    <application>
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
