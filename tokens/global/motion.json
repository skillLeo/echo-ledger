{
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "100ms"
    },
    "base": {
      "$type": "duration",
      "$value": "200ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "300ms"
    },
    "pulse": {
      "$type": "duration",
      "$value": "1500ms"
    },
    "ease": {
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "in": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    }
  }
}
