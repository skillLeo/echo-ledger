{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI Variable",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Native apps use the system face; the web face is chosen at Gate 3."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Cascadia Mono",
          "Roboto Mono",
          "monospace"
        ]
      },
      "urdu": {
        "$type": "fontFamily",
        "$value": [
          "Noto Nastaliq Urdu",
          "system-ui",
          "-apple-system",
          "Segoe UI Variable",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "arabic": {
        "$type": "fontFamily",
        "$value": [
          "Noto Naskh Arabic",
          "IBM Plex Sans Arabic",
          "system-ui",
          "-apple-system",
          "Segoe UI Variable",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      }
    }
  },
  "text": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "32px",
        "lineHeight": "40px",
        "fontWeight": 600
      }
    },
    "title-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "24px",
        "lineHeight": "32px",
        "fontWeight": 600
      }
    },
    "title-m": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 600
      }
    },
    "title-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 600
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 400
      }
    },
    "body-strong": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 600
      }
    },
    "section": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 500
      },
      "$description": "A section's title (v2.1 UX-16): text only, 14 sp medium in the secondary colour"
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 400
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "13px",
        "lineHeight": "20px",
        "fontWeight": 400
      }
    },
    "urdu-body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.urdu}",
        "fontSize": "16px",
        "lineHeight": "30px",
        "fontWeight": 400
      }
    },
    "urdu-title-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.urdu}",
        "fontSize": "24px",
        "lineHeight": "44px",
        "fontWeight": 600
      },
      "$description": "Nastaliq page title: Latin size, line height + 12 for its tall ascenders and deep descenders"
    },
    "urdu-title-m": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.urdu}",
        "fontSize": "20px",
        "lineHeight": "40px",
        "fontWeight": 600
      }
    },
    "urdu-title-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.urdu}",
        "fontSize": "16px",
        "lineHeight": "30px",
        "fontWeight": 600
      }
    },
    "urdu-caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.urdu}",
        "fontSize": "14px",
        "lineHeight": "28px",
        "fontWeight": 400
      },
      "$description": "Nastaliq below 14 px is unreadable: Urdu meta text never goes smaller"
    },
    "urdu-transcript": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.urdu}",
        "fontSize": "19px",
        "lineHeight": "38px",
        "fontWeight": 400
      },
      "$description": "Transcript and reading text (line height 2)"
    },
    "arabic-body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.arabic}",
        "fontSize": "15px",
        "lineHeight": "26px",
        "fontWeight": 400
      }
    },
    "arabic-title-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.arabic}",
        "fontSize": "24px",
        "lineHeight": "36px",
        "fontWeight": 600
      }
    },
    "arabic-title-m": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.arabic}",
        "fontSize": "20px",
        "lineHeight": "32px",
        "fontWeight": 600
      }
    },
    "arabic-title-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.arabic}",
        "fontSize": "16px",
        "lineHeight": "26px",
        "fontWeight": 600
      }
    },
    "arabic-caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.arabic}",
        "fontSize": "13px",
        "lineHeight": "22px",
        "fontWeight": 400
      }
    },
    "arabic-transcript": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.arabic}",
        "fontSize": "18px",
        "lineHeight": "30px",
        "fontWeight": 400
      },
      "$description": "Transcript and reading text (line height about 1.7)"
    },
    "body-mobile": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 400
      },
      "$description": "Body text on phones (Material bodyLarge)"
    }
  }
}
