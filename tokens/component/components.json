{
  "component": {
    "button": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{layout.control.height}"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{space.12}"
      }
    },
    "field": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{layout.control.height}"
      }
    },
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      }
    },
    "menu": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      }
    },
    "dialog": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.lg}"
      }
    },
    "sheet": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sheet}"
      }
    },
    "chip": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.full}"
      },
      "height": {
        "$type": "dimension",
        "$value": "32px"
      }
    },
    "list-row": {
      "height": {
        "$type": "dimension",
        "$value": "{layout.row.comfortable}"
      },
      "height-compact": {
        "$type": "dimension",
        "$value": "{layout.row.compact}"
      },
      "height-mobile": {
        "$type": "dimension",
        "$value": "{layout.row.mobile}"
      },
      "height-mobile-tall": {
        "$type": "dimension",
        "$value": "72px"
      }
    },
    "record-button": {
      "$type": "dimension",
      "$value": "56px",
      "$description": "The Record button in the middle of the phone's bottom bar"
    },
    "toast": {
      "duration": {
        "$type": "duration",
        "$value": "6000ms",
        "$description": "Long enough to reach Undo"
      }
    },
    "recording-dot": {
      "pulse": {
        "$type": "duration",
        "$value": "{motion.pulse}"
      }
    },
    "avatar": {
      "size": {
        "$type": "dimension",
        "$value": "40px"
      }
    },
    "status-dot": {
      "size": {
        "$type": "dimension",
        "$value": "8px"
      }
    },
    "sheet-handle": {
      "width": {
        "$type": "dimension",
        "$value": "32px"
      },
      "height": {
        "$type": "dimension",
        "$value": "4px"
      }
    },
    "tabs": {
      "indicator": {
        "$type": "dimension",
        "$value": "{border.strong}"
      }
    }
  }
}
